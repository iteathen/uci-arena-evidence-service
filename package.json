{
  "name": "@uci-arena/evidence-service",
  "version": "0.3.14",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "arena-evidence": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "acceptance:idle": "node fixtures/idle_acceptance.mjs",
    "check:automation": "node tools/check-github-automation.mjs",
    "check:boundary": "node tools/repository-boundary-check.mjs",
    "check:vendor": "node tools/verify-vendor-lock.mjs",
    "check": "npm run check:vendor && npm run check:boundary && npm run check:automation && npm test"
  },
  "dependencies": {
    "@uci-arena/background-service-runtime": "file:vendor/background-service-runtime",
    "@uci-arena/time-profile-contract": "file:vendor/time-profile-contract"
  }
}
