{
  "schema": "uci_arena_standalone_service_contract_v1",
  "component_id": "uci_arena_evidence.service",
  "component_version": "0.3.15",
  "cli_entrypoint": "services/evidence-service/src/cli.mjs",
  "configuration_schema": "uci_arena_evidence_service_config_v1",
  "status_schema": "uci_arena_evidence_status_v1",
  "schema_documents": {
    "status": "contracts/status-schema.json"
  },
  "capabilities": [
    "status",
    "start",
    "stop",
    "pause",
    "resume",
    "campaign",
    "profile_list",
    "startup_install",
    "startup_recover",
    "startup_uninstall"
  ],
  "data_paths": ["workspace"],
  "startup": {
    "windows": "per_user_task_scheduler",
    "linux": "per_user_systemd"
  },
  "health_smoke": {
    "command": "status",
    "success": "exit_zero_and_status_schema"
  },
  "manager_integration_api": {
    "schema": "uci_arena_manager_service_api_v1",
    "version": "1.0",
    "transport": "cli_json",
    "entrypoint": "cli",
    "arguments": ["api"],
    "operations": [
      "describe",
      "status",
      "outputs_list",
      "outputs_inspect",
      "config_validate",
      "orchestration_status",
      "target_register",
      "campaign_enqueue",
      "job_control"
      ,"startup_recover"
    ],
    "output_schema": "uci_arena_service_output_v1"
  },
  "outputs": {
    "dataset_schema": "uci_arena_evidence_dataset_v1",
    "profile_schema": "uci_arena_evidence_profile_v1"
  },
  "runtime_compatibility": {
    "component_id": "uci_arena_evidence.runtime",
    "contract_schema": "uci_arena_evidence_runtime_v1",
    "additional_profiles": [{
      "capability": "evidence_runtime_contract_v2",
      "entrypoint": "evidence_runtime_contract",
      "contract_schema": "uci_arena_evidence_runtime_v2",
      "request_schema": "uci_arena_evidence_request_v2",
      "output_schema": "uci_arena_evidence_result_v2",
      "target_schema": "uci_arena_evidence_target_v2",
      "authority": "diagnostic_only",
      "capability_admission": "selected_target_receipt_manifest_inventory_and_explicit_available_status",
      "campaign_parameters": "inventoried_bounded_structural_json_schema",
      "target_cli": ["api", "target", "register", "--target-json"],
      "campaign_cli": ["api", "campaign", "enqueue", "--target", "--campaign", "--configuration-json"],
      "maximum_cli_json_bytes": 8192
    }],
    "complete_game": {
      "entrypoint": "arena/run_complete_game_matrix.mjs",
      "output_schemas": [
        "uci_arena_complete_game_matrix_v3",
        "uci_arena_complete_game_matrix_v4"
      ],
      "authority": "diagnostic_only"
    }
  },
  "persistence": {
    "upgrade": "preserve_and_migrate",
    "repair": "preserve",
    "uninstall_default": "preserve"
  }
}
