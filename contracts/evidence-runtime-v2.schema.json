{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uci-arena:evidence-runtime:v2",
  "title": "Engine-owned JavaScript evidence runtime capability",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "component_id", "component_version", "target_triple", "runtime_identity", "referee", "resource_requirements", "capabilities", "campaigns"],
  "properties": {
    "schema": {"const": "uci_arena_evidence_runtime_v2"},
    "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "component_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.][A-Za-z0-9.-]+)?$"},
    "target_triple": {"enum": ["windows-x86_64", "linux-x86_64"]},
    "runtime_identity": {"type": "object", "additionalProperties": false, "required": ["path", "schema"], "properties": {"path": {"$ref": "#/$defs/path"}, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "referee": {"$ref": "#/$defs/path"},
    "resource_requirements": {"type": "object", "additionalProperties": false, "required": ["gpu"], "properties": {"gpu": {"type": "boolean"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["complete_game", "paired_sprt", "timing_profile"], "properties": {"complete_game": {"$ref": "#/$defs/capability"}, "paired_sprt": {"$ref": "#/$defs/capability"}, "timing_profile": {"$ref": "#/$defs/capability"}}},
    "campaigns": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "parameters_schema", "workloads"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}, "parameters_schema": {"$ref": "#/$defs/path"}, "workloads": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["complete_game", "paired_sprt", "timing_profile"]}}}}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "description": "Normalized contained POSIX relative regular-file path, listed in the selected component manifest inventory."},
    "capability": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unsupported"}, "reason": {"type": "string", "minLength": 1, "maxLength": 1024}}},
      {"type": "object", "additionalProperties": false, "required": ["status", "entrypoint", "request_schema", "output_schema"], "properties": {"status": {"const": "available"}, "entrypoint": {"$ref": "#/$defs/path"}, "request_schema": {"const": "uci_arena_evidence_request_v2"}, "output_schema": {"const": "uci_arena_evidence_result_v2"}}}
    ]}
  }
}
