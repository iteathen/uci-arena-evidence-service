{
  "schema": "arena_provider_component_definition_v1",
  "component_id": "uci_arena_evidence.service",
  "source_repository": "iteathen/uci-arena-evidence-service",
  "package_json": "package.json",
  "contract_manifest": "services/evidence-service/contracts/service-contract.json",
  "include": [
    {"source": "src", "target": "services/evidence-service/src"},
    {"source": "fixtures", "target": "services/evidence-service/fixtures"},
    {"source": "node_modules", "target": "services/evidence-service/node_modules"},
    {"source": "package.json", "target": "services/evidence-service/package.json"},
    {"source": "package-lock.json", "target": "services/evidence-service/package-lock.json"},
    {"source": "contracts", "target": "services/evidence-service/contracts"},
    {"source": "README.md", "target": "services/evidence-service/README.md"},
    {"source": "release/PROJECT-LICENSE-NOTICE.txt", "target": "licenses/LICENSE.txt"}
  ],
  "include_by_target": {
    "windows-x86_64": [
      {"source": "provider_stage/background_service_native", "target": "services/evidence-service/native"}
    ]
  },
  "entrypoints": {"cli": "services/evidence-service/src/cli.mjs"},
  "dependencies": [
    {"component_id": "node_runtime.private", "required": true, "binding": "private_component_runtime"},
    {"component_id": "uci_arena_evidence.runtime", "required": true, "binding": "explicit_runtime_root"},
    {"component_id": "uci_arena.engine", "required": true, "binding": "explicit_engine_and_model_roots"},
    {"component_id": "stockfish.engine", "required": true, "binding": "explicit_stockfish_path"}
  ],
  "capabilities": ["status", "start", "stop", "pause", "resume", "campaign", "profile_list", "startup_install", "startup_uninstall"],
  "startup": {"windows": "per_user_task_scheduler", "linux": "per_user_systemd"},
  "data_paths": ["workspace"],
  "dependency_lock_identities": {
    "node": ">=24.15.0",
    "npm_lock": "package-lock.json",
    "upstream_vendor_lock": "vendor/upstream.lock.json"
  },
  "tests": ["evidence_service_tests", "idle_acceptance", "runtime_contract_resolution"]
}
