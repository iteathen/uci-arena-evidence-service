{
  "schema": "arena_provider_component_definition_v1",
  "component_id": "uci_arena_evidence.service",
  "discovery": [
    {"kind": "evidence_service", "locator": {"source": "active_root"}}
  ],
  "source_repository": "iteathen/uci-arena-evidence-service",
  "package_json": "package.json",
  "native_toolchain_by_target": {
    "windows-x86_64": {
      "receipt_schema": "arena_native_toolchain_receipt_v1",
      "build_system": "cmake",
      "language": "cxx"
    }
  },
  "contract_manifest": "services/evidence-service/contracts/service-contract.json",
  "include": [
    {"source": "src", "target": "services/evidence-service/src"},
    {"source": "fixtures", "target": "services/evidence-service/fixtures"},
    {"source": "node_modules", "target": "services/evidence-service/node_modules"},
    {"source": "package.json", "target": "services/evidence-service/package.json"},
    {"source": "package-lock.json", "target": "services/evidence-service/package-lock.json"},
    {"source": "contracts", "target": "services/evidence-service/contracts"},
    {"source": "README.md", "target": "services/evidence-service/README.md"},
    {"source": "release/PROJECT-LICENSE-NOTICE.txt", "target": "licenses/LICENSE.txt"}
  ],
  "include_by_target": {
    "windows-x86_64": [
      {"source": "provider_stage/background_service_native", "target": "services/evidence-service/native"}
    ]
  },
  "entrypoints": {
    "cli": "services/evidence-service/src/cli.mjs",
    "installer_integration": "services/evidence-service/src/installer_integration.mjs"
  },
  "installer_integration": {
    "schema": "arena_provider_installer_integration_v1",
    "schema_version": 1,
    "entrypoint": "installer_integration",
    "invocation": {
      "kind": "dependency_runtime",
      "runtime_component_id": "node_runtime.private",
      "runtime_entrypoint": "node"
    },
    "arguments": ["--context"],
    "workspace_name": "evidence-service",
    "configure_when_disabled": false,
    "dependency_bindings": [
      {"name": "evidence_runtime_root", "component_id": "uci_arena_evidence.runtime", "source": "active_root", "required": true},
      {"name": "engine", "component_id": "uci_arena.engine", "source": "entrypoint", "entrypoint": "uci", "required": true},
      {"name": "model_root", "component_id": "uci_arena.engine", "source": "component_path", "path": "models/default", "required": true},
      {"name": "stockfish", "component_id": "stockfish.engine", "source": "entrypoint", "entrypoint": "stockfish", "required": true},
      {"name": "referee", "component_id": "uci_arena_evidence.runtime", "source": "entrypoint", "entrypoint": "referee", "required": true}
    ],
    "locator_bindings": [
      {"name": "timing_profile", "kind": "timing_profile", "required": false}
    ],
    "startup_control": {
      "schema": "arena_provider_startup_control_v1",
      "schema_version": 1,
      "entrypoint": "cli",
      "actions": {
        "install": ["startup", "install"],
        "uninstall": ["startup", "uninstall"]
      },
      "workspace_argument": {"flag": "--workspace", "relative_path": "."},
      "configuration_argument": "--config",
      "result": {
        "envelope": "root",
        "require_configuration_match_on_install": true,
        "require_live_on_install": true
      }
    }
  },
  "manager_integration_api": {
    "schema": "uci_arena_manager_service_api_v1",
    "version": "1.0",
    "transport": "cli_json",
    "entrypoint": "cli",
    "arguments": ["api"],
    "operations": ["describe", "status", "outputs_list", "outputs_inspect", "config_validate", "orchestration_status", "target_register", "campaign_enqueue", "job_control"],
    "output_schema": "uci_arena_service_output_v1"
  },
  "dependencies": [
    {"component_id": "node_runtime.private", "required": true, "binding": "private_component_runtime"},
    {"component_id": "uci_arena_evidence.runtime", "required": true, "binding": "explicit_runtime_root"},
    {"component_id": "uci_arena.engine", "required": true, "binding": "explicit_engine_and_model_roots"},
    {"component_id": "stockfish.engine", "required": true, "binding": "explicit_stockfish_path"}
  ],
  "capabilities": ["status", "start", "stop", "pause", "resume", "campaign", "profile_list", "startup_install", "startup_uninstall"],
  "startup": {"windows": "per_user_task_scheduler", "linux": "per_user_systemd"},
  "data_paths": ["workspace"],
  "dependency_lock_identities": {
    "node": ">=24.15.0",
    "npm_lock": "package-lock.json",
    "upstream_vendor_lock": "vendor/upstream.lock.json"
  },
  "tests": ["evidence_service_tests", "idle_acceptance", "runtime_contract_resolution"]
}
